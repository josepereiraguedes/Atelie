{
  "name": "sistema-gestao-estoque",
  "private": true,
  "version": "1.0.3",
  "description": "Sistema de Gestão de Estoque e Financeiro",
  "author": "Ateliê",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "npm run electron:dev",
    "test": "npx tsx tests/run-tests.ts",
    "test:components": "npx tsx src/__tests__/components/run-component-tests.ts",
    "test:hooks": "npx tsx src/__tests__/hooks/run-hook-tests.ts",
    "test:integration": "npx tsx tests/comprehensive-integration-test.ts",
    "electron": "wait-on tcp:3000 && electron .",
    "electron:dev": "concurrently \"npm run dev\" \"npm run electron\"",
    "electron:build": "npm run build && xcopy dist electron\\dist /E /I /Y && electron-builder build --win",
    "electron:package": "xcopy dist electron\\dist /E /I /Y && electron-builder --win --x64",
    "postpackage": "rd /s /q electron\\dist",
    "postinstall": "electron-builder install-app-deps",
    "build:installer": "node scripts/build-installer.mjs",
    "sign:installer": "node scripts/sign-installer.mjs",
    "publish:release": "node scripts/publish-release.mjs",
    "verify:installer": "node scripts/verify-installer.mjs",
    "update:installer": "node scripts/update-installer.mjs"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "bcryptjs": "^2.4.3",
    "date-fns": "^3.0.6",
    "electron-log": "^5.2.4",
    "electron-updater": "^6.3.9",
    "framer-motion": "^10.16.16",
    "jspdf": "^3.0.2",
    "jspdf-autotable": "^3.8.2",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.48.2",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.21.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@eslint/js": "^9.27.0",
    "@playwright/test": "^1.56.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "app-builder-bin": "^3.7.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "dotenv": "^16.6.1",
    "electron": "^38.3.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.27.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "icon-gen": "^5.0.0",
    "ieee754": "^1.2.1",
    "jimp": "^1.6.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.32.1",
    "vite": "^6.3.5",
    "vitest": "^4.0.7",
    "wait-on": "^9.0.1"
  }
}