{
  "appId": "com.atelie.gestao",
  "productName": "Sistema Gestão Ateliê",
  "directories": {
    "output": "dist_electron"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "server/**/*",
    "local_database/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      "nsis"
    ],
    "icon": "build/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Sistema Gestão Ateliê",
    "deleteAppDataOnUninstall": true,
    "runAfterFinish": true,
    "installerIcon": "build/icon.ico",
    "uninstallerIcon": "build/icon.ico",
    "installerHeaderIcon": "build/icon.ico"
  },
  "npmRebuild": false
}