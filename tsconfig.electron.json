{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "./electron/dist/src",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "jsx": "react"
  },
  "include": [
    "src/services/autoUpdate.ts",
    "src/services/autoBackup.ts",
    "src/services/versionHistory.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "electron/dist"
  ]
}